# ===== Claude API =====
# https://console.anthropic.com/ で発行したAPIキー
ANTHROPIC_API_KEY=
# 使うモデル（通常は変更不要）
CLAUDE_MODEL=claude-opus-5-5

# ===== Slack =====
# Slackアプリの「OAuth & Permissions」にある Bot User OAuth Token（xoxb-で始まる）
SLACK_BOT_TOKEN=
# Slackアプリの「Basic Information」→「App-Level Tokens」で作るトークン（xapp-で始まる、connections:write権限）
SLACK_APP_TOKEN=
# 企画を投稿するチャンネルのID（チャンネル名を右クリック→「リンクをコピー」の末尾 C から始まる文字列）
SLACK_CHANNEL_ID=

# ===== 競合調査 =====
# YouTube Data API v3 のAPIキー（未設定なら YouTube 調査はスキップ）
YOUTUBE_API_KEY=
# Web検索による今週の話題調査を使うか（true/false）。使うとClaude APIの費用が約3倍になるため既定は false
RESEARCH_WEB_SEARCH=false

# ===== スケジュール =====
# 毎朝の企画作成の時刻（cron形式・日本時間）。既定は毎朝6:30に開始→7時頃に届く
MORNING_CRON=30 6 * * *
