{
  "name": "tiktok-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "6つのTikTokアカウントの企画・動画作成・投稿を自動化するエージェント群",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "plan:now": "tsx src/cli/runMorning.ts",
    "plan:dry": "tsx src/cli/runMorning.ts --dry-run",
    "slack:test": "tsx src/cli/slackTest.ts",
    "check": "tsc --noEmit && tsc --noEmit -p video",
    "test": "node --import tsx --test test/*.test.ts",
    "video:studio": "remotion studio video/index.ts",
    "produce:dry": "tsx src/cli/produce.ts",
    "video:sample": "tsx src/cli/renderSample.ts",
    "icons": "tsx src/cli/renderIcons.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@remotion/three": "^4.0.536",
    "@slack/bolt": "^5.1.0",
    "dotenv": "^18.0.8",
    "node-cron": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.536",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
